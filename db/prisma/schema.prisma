// Prisma Schema untuk Nongki-Yuk (Milestone 1)

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Event {
  id              String        @id @db.VarChar(32)
  title           String        @db.VarChar(255)
  timezone        String        @default("Asia/Jakarta") @db.VarChar(50)
  startDate       DateTime      @db.Date @map("start_date")
  endDate         DateTime      @db.Date @map("end_date")
  dayStartMin     Int           @default(540) @map("day_start_min")
  dayEndMin       Int           @default(1320) @map("day_end_min")
  slotMinutes     Int           @default(30) @map("slot_minutes")
  minDurationMin  Int           @default(120) @map("min_duration_min")
  lockedStartUtc  DateTime?     @map("locked_start_utc") @db.Timestamptz
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz
  expiresAt       DateTime      @map("expires_at") @db.Timestamptz

  participants    Participant[]

  @@index([expiresAt])
  @@map("events")
}

model Participant {
  id              String         @id @default(uuid()) @db.Uuid
  eventId         String         @map("event_id") @db.VarChar(32)
  name            String         @db.VarChar(100)
  editTokenHash   String         @map("edit_token_hash") @db.VarChar(255)
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  event           Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  availabilities  Availability[]

  @@unique([eventId, name])
  @@index([eventId])
  @@map("participants")
}

model Availability {
  participantId   String      @map("participant_id") @db.Uuid
  slotStartUtc    DateTime    @map("slot_start_utc") @db.Timestamptz
  eventId         String      @map("event_id") @db.VarChar(32)

  participant     Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@id([participantId, slotStartUtc])
  @@index([eventId, slotStartUtc])
  @@map("availability")
}
